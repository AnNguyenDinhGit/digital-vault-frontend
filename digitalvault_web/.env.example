# Base URL cho Axios (giữ /api để đi qua Vite proxy khi dev)
VITE_API_BASE_URL=/api
# Địa chỉ BE mà Vite proxy chuyển tiếp tới
VITE_PROXY_TARGET=https://localhost:7015
# Bật API giả (MSW) khi BE chưa chạy được. Mật khẩu chung: Owner@123456
# Tài khoản demo: owner@example.com (Owner), executor@example.com (Executor), verifier@example.com (LegalVerifier),
#                 beneficiary@example.com (Beneficiary), admin@example.com (Admin)
VITE_USE_MOCK=false
